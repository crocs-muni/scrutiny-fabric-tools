# investigations are local-only scratch space, EXCEPT their published reports.
# The protocol spec's Appendix E cites investigations/diff-parity/REPORT.md by path,
# so that file must be publicly reachable.
investigations/**
!investigations/*/
!investigations/*/REPORT.md

# deps
node_modules/

# build output
dist/
*.tsbuildinfo

# API Extractor's scratch comparison copy (etc/api-report.api.md is the real, committed report)
temp/

# test output
coverage/
.vitest-cache/

# StrykerJS mutation testing — regenerable reports + sandbox; the committed
# config lives at packages/core/stryker.config.mjs
reports/
packages/core/stryker-tmp/

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# env / secrets
.env
.env.*
!.env.example
*.nsec
*.key

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# changeset files must be committed — the CI changeset-presence gate requires them.

packages/mirror/artifacts*/

# example port scratch dirs (bulk events.ndjson + node_modules; local only)
examples/jcalgtest-port/
examples/sec-certs-port/
examples/publish-bulk.mjs

# release scratch
dist-release/

# root-level scratch artifacts
artifacts/
