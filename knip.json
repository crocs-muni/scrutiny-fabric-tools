{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "exports": "warn",
    "types": "warn"
  },
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs!"],
      "project": ["tools/*.mjs"]
    },
    "packages/core": {
      "vitest": false,
      "entry": ["src/index.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "examples/signers": {
      "entry": ["noble-signer.ts"],
      "project": ["*.ts"]
    },
    "packages/mirror": {
      "entry": [
        "src/emit/index.ts",
        "src/gate/index.ts",
        "src/loaders/jcalgtest.ts",
        "src/loaders/seccerts.ts",
        "src/emit/jcalgtest-repin.ts",
        "src/emit/selftest.ts",
        "src/gate/selftest.ts",
        "src/publish/selftest.ts",
        "src/emit/seccerts/index.ts",
        "src/emit/seccerts/plan.ts",
        "src/emit/jcalgtest-repin.test.ts",
        "src/ledger/seccertsLedger-gate.test.ts"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
