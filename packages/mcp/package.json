{
  "name": "@scrutiny-fabric/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that turns a publisher's local security files into SCRUTINY Fabric events and publishes them after user approval (docs/specs/mcp-publishing.md).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "//private": "Private until spec §18 step 6 (release): the engine is incomplete, and the published package must depend on the published @scrutiny-fabric/core, which is not on npm yet (spec §16).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "scrutiny-fabric-mcp": "./dist/bin.js"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scrutiny-fabric/core": "workspace:*",
    "@scure/base": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "8.18.2",
    "fast-check": "^4.10.2",
    "nostr-tools": "2.25.2",
    "typescript": "^5.8",
    "vitest": "^5.0.5",
    "ws": "8.22.1"
  }
}
