{
  "name": "@crocs-muni/scrutiny-fabric-mcp",
  "version": "0.1.0",
  "description": "MCP server that turns a publisher's local security files into SCRUTINY Fabric events and publishes them after user approval (docs/specs/mcp-publishing.md).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crocs-muni/scrutiny-fabric-tools.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/crocs-muni/scrutiny-fabric-tools/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/crocs-muni/scrutiny-fabric-tools/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "scrutiny-fabric-mcp": "./dist/bin.js"
  },
  "files": ["dist", "src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@crocs-muni/scrutiny-fabric": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "8.18.2",
    "fast-check": "^4.10.2",
    "nostr-tools": "2.25.2",
    "typescript": "^5.8",
    "vitest": "^5.0.5",
    "ws": "8.22.1"
  }
}
